{
  "openapi": "3.1.0",
  "info": {
    "title": "DataCo - Servicio de IA de riesgo de entrega tardía",
    "description": "API REST que expone un modelo de clasificación (HistGradientBoosting) entrenado con el dataset **DataCo Smart Supply Chain** para predecir si un pedido tendrá entrega tardía.\n\nPermite: realizar predicciones, consultar el historial, consultar métricas, enviar archivos de entrenamiento y re-entrenar el modelo.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/predicciones": {
      "post": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Enviar datos al modelo y obtener la predicción",
        "description": "Predice si un pedido tendrá **entrega tardía** (1) o llegará **a tiempo** (0) y guarda la predicción en el historial.",
        "operationId": "crear_prediccion_api_predicciones_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrediccionEntrada"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrediccionSalida"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      },
      "get": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Historial de predicciones previas",
        "description": "Devuelve los datos enviados y el resultado de cada predicción, de la más reciente a la más antigua.",
        "operationId": "listar_predicciones_api_predicciones_get",
        "parameters": [
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Pagina"
            }
          },
          {
            "name": "tamano",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Tamano"
            }
          },
          {
            "name": "prediccion",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 1,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por resultado (0 o 1)",
              "title": "Prediccion"
            },
            "description": "Filtrar por resultado (0 o 1)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistorialPredicciones"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/predicciones/{prediccion_id}": {
      "get": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Detalle de una predicción",
        "operationId": "obtener_prediccion_api_predicciones__prediccion_id__get",
        "parameters": [
          {
            "name": "prediccion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Prediccion Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrediccionSalida"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/opciones": {
      "get": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Valores válidos de las variables categóricas",
        "description": "Valores aceptados por el modelo activo para cada variable categórica (para construir el formulario).",
        "operationId": "obtener_opciones_api_opciones_get",
        "responses": {
