              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/VersionModeloSalida"
                  },
                  "type": "array",
                  "title": "Response Listar Modelos Api Modelos Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/modelos/reentrenar": {
      "post": {
        "tags": [
          "Modelo"
        ],
        "summary": "Re-entrenar el modelo con los datos actualizados",
        "description": "Entrena una nueva versión con todos los datos de entrenamiento activos en la base de datos.\n\nLa nueva versión solo reemplaza al modelo activo si cumple el criterio de calidad (CRISP-ML(Q)).",
        "operationId": "reentrenar_api_modelos_reentrenar_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ReentrenamientoEntrada"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Entrada"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReentrenamientoSalida"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/modelos/{version}/activar": {
      "post": {
        "tags": [
          "Modelo"
        ],
        "summary": "Activar una versión anterior (rollback)",
        "operationId": "activar_version_api_modelos__version__activar_post",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
