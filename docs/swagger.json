          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
    "/api/destinos": {
      "get": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Combinaciones válidas de mercado, región y país",
        "description": "Combinaciones mercado / región / país presentes en los datos de entrenamiento activos (para filtrar el formulario en cascada).",
        "operationId": "listar_destinos_api_destinos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Destino"
                  },
                  "type": "array",
                  "title": "Response Listar Destinos Api Destinos Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/metricas": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Métricas de rendimiento del modelo activo",
        "description": "Accuracy, precision, recall, F1, ROC-AUC y matriz de confusión del modelo activo, calculadas sobre el conjunto de prueba (20%).",
        "operationId": "obtener_metricas_api_metricas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricasModeloSalida"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          }
        }
      }
    },
    "/api/modelos": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Historial de versiones del modelo",
        "description": "Todas las versiones entrenadas con sus métricas, de la más reciente a la más antigua.",
        "operationId": "listar_modelos_api_modelos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
