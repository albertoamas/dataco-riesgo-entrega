                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_cargar_dataset_api_datasets_post": {
        "properties": {
          "archivo": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Archivo",
            "description": "CSV original de DataCo o CSV con las columnas preparadas"
          },
          "modo": {
            "type": "string",
            "enum": [
              "agregar",
              "reemplazar"
            ],
            "title": "Modo",
            "description": "agregar: suma los datos a los existentes; reemplazar: desactiva los datasets anteriores",
            "default": "agregar"
          },
          "reentrenar": {
            "type": "boolean",
            "title": "Reentrenar",
            "description": "Re-entrenar el modelo inmediatamente después de la carga",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "archivo"
        ],
        "title": "Body_cargar_dataset_api_datasets_post"
      },
      "CargaDatasetSalida": {
        "properties": {
          "mensaje": {
            "type": "string",
            "title": "Mensaje"
          },
