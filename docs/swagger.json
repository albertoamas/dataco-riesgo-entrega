              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "mensaje",
          "dataset",
          "registros_descartados",
          "total_registros_activos"
        ],
        "title": "CargaDatasetSalida"
      },
