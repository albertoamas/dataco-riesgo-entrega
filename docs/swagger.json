          "hiperparametros",
          "metricas",
          "matriz_confusion",
          "registros_entrenamiento",
          "registros_prueba",
          "cumple_calidad",
          "activo",
          "origen",
          "fecha_entrenamiento",
          "criterio_calidad",
          "total_predicciones"
        ],
        "title": "MetricasModeloSalida"
      },
      "Opciones": {
        "properties": {
          "version_modelo": {
            "type": "integer",
            "title": "Version Modelo"
          },
          "opciones": {
            "additionalProperties": {
              "items": {
