            "title": "Fecha Carga"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre_archivo",
          "formato",
          "total_registros",
          "activo",
          "fecha_carga"
        ],
        "title": "DatasetSalida"
      },
      "Destino": {
