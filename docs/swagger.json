    "/api/datasets": {
      "get": {
        "tags": [
          "Datos de entrenamiento"
        ],
        "summary": "Archivos de entrenamiento cargados",
        "operationId": "listar_datasets_api_datasets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DatasetSalida"
                  },
                  "type": "array",
                  "title": "Response Listar Datasets Api Datasets Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Datos de entrenamiento"
        ],
        "summary": "Enviar un archivo de entrenamiento (CSV)",
        "description": "Acepta dos formatos:\n\n- **dataco**: el CSV original `DataCoSupplyChainDataset.csv` (se preparan las columnas automáticamente).\n- **preparado**: CSV con las columnas `payment_type, shipping_mode, market, order_region, order_country,\n  customer_segment, category_name, quantity, product_price, discount_rate, order_month,\n  order_day_of_week, order_hour, late_delivery_risk`.",
        "operationId": "cargar_dataset_api_datasets_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_cargar_dataset_api_datasets_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CargaDatasetSalida"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/salud": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Estado del servicio",
        "operationId": "salud_api_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
